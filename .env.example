# Local development secrets for Wrangler
# Copy this file to `.dev.vars` (preferred) or `.env` — never commit real values.
#
#   cp .env.example .dev.vars

# Protects programmatic API routes (Authorization: Bearer <API_KEY>)
API_KEY=replace_with_a_long_random_string

# Dashboard login PIN shown to humans (default 1111)
DASHBOARD_PIN=1111

# Shopify Admin API
SHOPIFY_STORE_DOMAIN=shxato.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# Supabase (use service_role only on the Worker — never in browsers)
# Tables live in independent schema `shixato` (not public).
# Dashboard → Settings → API → Exposed schemas must include: shixato
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: AI product filter (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# AliExpress Open Platform (Dropshipping) — server-side only
ALIEXPRESS_APP_KEY=542818
ALIEXPRESS_APP_SECRET=replace_with_app_secret
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_CALLBACK_URL=https://shixato.workers.dev/api/auth/aliexpress/callback

# Pricing defaults
DEFAULT_MARKUP=1.4
MAX_PRODUCT_IMAGES=8
ENVIRONMENT=development
